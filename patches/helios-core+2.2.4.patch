+// Run `mapper` over `items` with at most `limit` in flight at once, preserving input order
+// in the result. Used to parallelize file hash validation (otherwise done one file at a time),
+// which is the main bottleneck in large modpack/asset integrity checks.
+async function mapLimit(items, limit, mapper) {
+    const results = new Array(items.length);
+    let next = 0;
+    async function worker() {
+        while (true) {
+            const i = next++;
+            if (i >= items.length) {
+                return;
+            }
+            results[i] = await mapper(items[i], i);
+        }
+    }
+    const workers = [];
+    for (let i = 0; i < Math.min(limit, items.length); i++) {
+        workers.push(worker());
+    }
+    await Promise.all(workers);
