# 이 파일을 .env로 복사하고 값을 채우세요. .env는 .gitignore에 포함되어 커밋되지 않습니다.

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# 등록을 받을 채널 ID (디스코드 개발자 모드 켜고 채널 우클릭 > ID 복사)
DISCORD_CHANNEL_ID=

# cyml-distro-worker 주소 (distro-builder/whitelist-app.js의 WORKER_BASE_URL과 동일한 값)
WORKER_BASE_URL=https://cyml-distro-worker.chaenna02.workers.dev

# distro-builder 관리자 패널(1-2. 화이트리스트 키 관리)에서 발급한 위임 키.
# 이 디스코드 서버에 연결할 마크 서버(SERVER_ID) 하나만 체크해서 발급할 것.
WHITELIST_KEY=

# distribution.json에서 이 디스코드 서버가 연결되는 마크 서버의 id (예: Ssachon)
SERVER_ID=

# 같은 유저가 연속으로 메시지를 보낼 때 무시할 최소 간격(초). 생략 시 10.
COOLDOWN_SECONDS=10
