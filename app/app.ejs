    <!-- 서버 배경 레이어: 슬롯 2개를 opacity로 교차 전환 (GPU 합성만 사용) -->
    <div id="bgLayer"><div class="bgSlot"></div><div class="bgSlot"></div></div>

    <!-- 서버 배경 위에 깔리는 비네팅/액센트 글로우 레이어 (정적, 애니메이션 없음 → 성능 영향 최소) -->
    <div id="ambientLayer"></div>

    <!-- 런처 자동 업데이트 진행 배너 (uicore.js가 제어) -->
    <div id="updateBanner" aria-live="polite">
        <svg class="updateBannerIcon" viewBox="0 0 24 24"><use href="#i-refresh"/></svg>
        <div class="updateBannerBody">
            <span id="updateBannerText"></span>
            <div class="updateBannerTrack"><div id="updateBannerBar"></div></div>
        </div>
    </div>

    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <svg id="loadRing" viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="loadRingTrack" cx="60" cy="60" r="54"/>
                    <circle class="loadRingArc" cx="60" cy="60" r="54"/>
                </svg>
                <img id="loadSpinnerImage" class="rotating" src="assets/images/Icon.png">
            </div>
        </div>
    </div>
</body>
</html>
