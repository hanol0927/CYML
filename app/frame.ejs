<div id="frameBar">
    <div id="frameResizableTop" class="frameDragPadder"></div>
    <div id="frameMain">
        <div class="frameResizableVert frameDragPadder"></div>
        <%if (process.platform === 'darwin') { %>
            <div id="frameContentDarwin">
                <div id="frameButtonDockDarwin">
                    <button class="frameButtonDarwin fCb" id="frameButtonDarwin_close" tabIndex="-1"></button>
                    <button class="frameButtonDarwin fMb" id="frameButtonDarwin_minimize" tabIndex="-1"></button>
                    <button class="frameButtonDarwin fRb" id="frameButtonDarwin_restoredown" tabIndex="-1"></button>
                </div>
                <div id="frameTitleDockDarwin">
                    <span id="frameTitleText"><%= lang('app.title') %></span>
                </div>
            </div>
        <% } else{ %>
            <div id="frameContentWin">
                <div id="frameTitleDock">
                    <svg class="frameLogo" viewBox="0 0 64 64" aria-hidden="true"><use href="#i-logo"/></svg>
                    <span id="frameTitleText"><%= lang('app.title') %></span>
                    <span id="frameTitleDivider"></span>
                    <span id="frameTitleSub"><%- lang('landingUi.frameTagline') %></span>
                </div>
                <div id="frameButtonDockWin">
                    <button class="frameButton fMb" id="frameButton_minimize" tabIndex="-1" title="최소화">
                        <svg class="frameIcon" viewBox="0 0 24 24"><use href="#i-minimize"/></svg>
                    </button>
                    <button class="frameButton fRb" id="frameButton_restoredown" tabIndex="-1" title="최대화">
                        <svg class="frameIcon" viewBox="0 0 24 24"><use href="#i-maximize"/></svg>
                    </button>
                    <button class="frameButton fCb" id="frameButton_close" tabIndex="-1" title="닫기">
                        <svg class="frameIcon" viewBox="0 0 24 24"><use href="#i-close"/></svg>
                    </button>
                </div>
            </div>
        <% } %>
        <div class="frameResizableVert frameDragPadder"></div>
    </div>
</div>
